[Unit]
Description=Tendrix Telegram Bot
After=network.target

[Service]
User=user1
WorkingDirectory=/home/user1/fz_parser
EnvironmentFile=/home/user1/fz_parser/.env
ExecStart=/usr/bin/python3 /home/user1/fz_parser/bot.py
Restart=always
RestartSec=3
StandardOutput=append:/home/user1/fz_parser/bot.log
StandardError=append:/home/user1/fz_parser/bot.log

[Install]
WantedBy=multi-user.target
