# SMTP Yandex: SSL — порт 465; при необходимости STARTTLS — SMTP_PORT=587
# Почта → Все настройки → Безопасность → «Пароли приложений» — создать для SMTP.
# В SMTP_PASSWORD указывайте только этот пароль (не основной пароль от аккаунта).
# Ошибка 535 в логах = неверный логин или пароль приложения.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_EMAIL=your-mail@yandex.ru
SMTP_PASSWORD=your-app-password

# Базовый URL сайта для ссылок в письмах (для локальной разработки: http://localhost:8080)
SITE_BASE_URL=https://tendrix.io

# OpenAI (функции с ИИ)
OPENAI_API_KEY=
# Опционально: HTTP-прокси для запросов к OpenAI
# OPENAI_HTTP_PROXY=http://user:pass@host:port

# Внешний поиск + RAG для углубленного анализа подводных камней
SEARCH_GOOGLE_URL=https://159.194.208.20.nip.io/api/search/google
SEARCH_GOOGLE_API_KEY=
# SEARCH_GOOGLE_SIZE=5
# SEARCH_GOOGLE_TIMEOUT=18

# Парсеры ЕИС и httpx (OpenAI в main.py): один прокси на все исходящие HTTP(S)
# Формат: http://user:pass@host:port  или из панели: host:port:user:pass
# PARSER_HTTP_PROXY=http://user:pass@proxy.example.com:8000
# PARSER_HTTP_PROXY=proxy.example.com:8000:login:secret

# Telegram-бот (уведомления, bot.py, tg_notify)
TELEGRAM_BOT_TOKEN=
# Публичная ссылка на бота (кнопка в шапке → /api/public/telegram-bot). Если пусто — username из getMe по TELEGRAM_BOT_TOKEN
# TELEGRAM_BOT_URL=https://t.me/YourBot
# TELEGRAM_BOT_USERNAME=YourBot

# Умный поиск (main.py): порог 0–100 и размер батча для оценки релевантности OpenAI
# AI_SEARCH_MIN_RELEVANCE=60
# AI_SEARCH_SCORE_CHUNK=12
# AI_SEARCH_SCAN_MAX_PAGES=12
# Тот же backend на VPS: лучше http://127.0.0.1:8080 — иначе /token к tendrix.io может не сработать.
# LEGACY_SEARCH_URL=http://127.0.0.1:8080
# LEGACY_SEARCH_USERNAME=admin
# LEGACY_SEARCH_PASSWORD=...
