# SMTP Yandex: SSL — порт 465; при необходимости STARTTLS — SMTP_PORT=587
# В настройках Яндекс.Почты включите доступ по IMAP/SMTP и пароль приложения.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_EMAIL=tendrix.io@yandex.ru
SMTP_PASSWORD=your-app-password

# Базовый URL сайта для ссылок в письмах (для локальной разработки: http://localhost:8080)
SITE_BASE_URL=https://tendrix.io

# OpenAI (функции с ИИ)
OPENAI_API_KEY=
# Опционально: HTTP-прокси для запросов к OpenAI
# OPENAI_HTTP_PROXY=http://user:pass@host:port

# Telegram-бот (уведомления, bot.py, tg_notify)
TELEGRAM_BOT_TOKEN=
