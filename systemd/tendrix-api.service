[Unit]
Description=Tendrix — веб-приложение (FastAPI / uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/Tendrix
EnvironmentFile=-/root/Tendrix/.env
ExecStart=/root/Tendrix/.venv/bin/python3 -u main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
